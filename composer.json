{
  "name": "8fold/php-syndication",
  "type": "package",
  "description": "A package for generating RSS and Atom feeds (XML)",
  "license": "MIT",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "authors": [
    {
      "name": "Josh Bruce",
      "email": "josh@8fold.pro",
      "homepage": "https://joshbruce.com",
      "role": "Lead Developer"
    }
  ],
  "support": {
  },
  "autoload": {
    "psr-4": {
      "Eightfold\\Syndication\\": "./src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Eightfold\\Syndication\\Tests\\": "./tests"
    }
  },
  "require": {
    "php": "^8.1",
    "8fold/php-xml-builder": "^4.0"
  },
  "require-dev": {
    "symfony/process": "^5.4 || ^6.0 || ^7.0 || ^8.0",

    "squizlabs/php_codesniffer": "^3.6 || ^4.0",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",

    "phpstan/phpstan": "^2.0.0",
    "phpstan/phpstan-strict-rules": "^2.1",
    "spaze/phpstan-disallowed-calls": "^4.15",
    "phpstan/extension-installer": "*",

    "phpunit/phpunit": "^9.5.21 || ^10.5.9 || ^11.0.0 || ^12.0.0 || ^13.0.0"
  },
  "scripts": {
    "prod": "@production",
    "production": [
      "@autoload:prod",
      "@check"
    ],

    "local": [
      "@autoload:local",
      "@check"
    ],

    "check": [
      "@check:dependencies",
      "@check:tabs",
      "@check:style",
      "@check:analysis",
      "@check:test"
    ],
    "check:dependencies": "composer validate --no-check-publish",
    "check:tabs": "php ./bin/check-tabs.php",
    "check:style": "./vendor/bin/phpcs --standard=phpcs.xml",
    "check:analysis": "./vendor/bin/phpstan analyze",
    "check:test": "./vendor/bin/phpunit",
    "check:test:ci": "./vendor/bin/phpunit --no-coverage --no-configuration --bootstrap vendor/autoload.php tests/",

    "fix:style": "./vendor/bin/phpcbf --standard=phpcs.xml",

    "autoload:prod": "composer dumpautoload --no-dev --classmap-authoritative",
    "autoload:local": "composer dumpautoload -o"
  },
  "extra": {
    "phpstan/extension-installer": {
      "ignore": [
        "spaze/phpstan-disallowed-calls"
      ]
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  }
}
